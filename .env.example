# 複製為 .env 後填入；已存在的系統環境變數會優先於 .env 的設定。

# Discord Webhook 網址（必填）
DISCORD_WEBHOOK_URL=

# ---- 以下皆為選填 ----

# 要檢查的公告分類，逗號分隔；每個分類各自比對最新的一篇公告，有變化就各自發送
# 可用值：update（更新）、bm（購物商場）、event（活動）、maintenance（維護）、sanction（制裁）、all（全部）
# ARTALE_NEWS_CATEGORIES=update,bm

# 已發送公告版本的紀錄檔（相對路徑以專案根目錄為準）
# STATE_FILE=data/state.json

# Discord 每則訊息的操作紀錄（所有 Webhook 合計最多 100 筆；供 webhook list 查詢 ID，不含 token）
# DISCORD_MESSAGES_FILE=data/discord-messages.jsonl

# Codex CLI 執行檔（cron 等 PATH 較少的環境建議填絕對路徑）、模型與逾時毫秒數
# CODEX_BIN=codex
# CODEX_MODEL=
# CODEX_TIMEOUT_MS=300000

# ---- npm run schedule 常駐模式的排程 ----
# 只在指定的星期幾、指定的時間區段內，每隔 CHECK_INTERVAL_MINUTES 分鐘檢查一次。
# 預設為每週二 08:20～17:20、每 60 分鐘一次（08:20、09:20、…、17:20），以台灣時間計算。

# 星期幾：1～7（1=週一 … 7=週日），可用逗號與範圍，例如 2、1-5、2,4
# SCHEDULE_DAYS=2
# 每天開始與最後一次檢查的時間（24 小時制 HH:MM，不支援跨越午夜）
# SCHEDULE_START=08:20
# SCHEDULE_END=17:20
# 檢查間隔（分鐘）
# CHECK_INTERVAL_MINUTES=60
# 計算排程時間用的時區
# SCHEDULE_TIMEZONE=Asia/Taipei
