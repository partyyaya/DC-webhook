{
  "name": "dcwebhook",
  "version": "1.0.0",
  "description": "定時檢查 Artale 官方公告，並每日整理美國經濟與虛擬貨幣新聞，以 Codex CLI 產生繁體中文摘要後發送到 Discord Webhook",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "artale": "node src/artale/index.js",
    "artale:preview": "node src/artale/index.js --dry-run",
    "artale:schedule": "node src/artale/scheduler.js",
    "artale:webhook": "node src/artale/webhook.js",
    "crypto": "node src/crypto/index.js",
    "crypto:preview": "node src/crypto/index.js --dry-run",
    "crypto:schedule": "node src/crypto/scheduler.js",
    "crypto:webhook": "node src/crypto/webhook.js",
    "webhook": "node src/webhook.js",
    "test": "node --test"
  }
}
