# 複製為 env/.env.crypto 後填入；系統環境變數優先。

# ---- Crypto 專屬設定 ----
# Crypto Discord Webhook 網址（正式發送必填）
CRYPTO_DISCORD_WEBHOOK_URL=

# 以下 Crypto 設定皆為選填；不共用其他主題的 Webhook 或排程。

# 每日新聞紀錄：最後完成發送的日期與目前的新聞訊息 ID（相對路徑以專案根目錄為準）
# CRYPTO_STATE_FILE=data/crypto/state.json

# Discord 每則訊息的操作紀錄（所有 Webhook 合計最多 100 筆；供 webhook list 查詢 ID，不含 token）
# CRYPTO_DISCORD_MESSAGES_FILE=data/crypto/discord-messages.jsonl

# ---- 新聞內容 ----
# 虛擬貨幣新聞的優先幣種，逗號分隔；填寫順序就是搜尋與排列的優先順序（排越前面越優先）
# 每個幣種至少 1 則（選該幣種最重要的新聞）；篇數少於幣種數量時，依填寫順序只取前幾個幣種
# 篇數多於幣種數量時，剩餘名額只放重要新聞（上列幣種的第 2 則、其他幣種或整體市場），不會用不重要的新聞補滿
# CRYPTO_PRIORITY_COINS=BTC,ADA,ETH

# 每天發送的美國經濟新聞篇數（1～10）
# CRYPTO_ECONOMY_NEWS_COUNT=3
# 每天發送的虛擬貨幣新聞最多篇數（1～10）；超過幣種數量的名額沒有重要新聞時會少於此數
# CRYPTO_COIN_NEWS_COUNT=3

# Codex 網路搜尋與整理新聞的逾時時間（毫秒），與共用的 CODEX_TIMEOUT_MS 分開
# CRYPTO_CODEX_TIMEOUT_MS=600000

# ---- npm run crypto:schedule 常駐模式的排程 ----
# 每天在指定時間搜尋前 24 小時的新聞，先刪除前一次的新聞訊息再發送。
# 預設為每天 08:00 一次，以台灣時間計算；當天時間已過但尚未發送時，啟動或喚醒後會立即補發。

# 星期幾：1～7（1=週一 … 7=週日），可用逗號與範圍，例如 1-5、1-7
# CRYPTO_SCHEDULE_DAYS=1-7
# 每天發送的時間（24 小時制 HH:MM）
# CRYPTO_SCHEDULE_TIME=08:00
# 計算排程時間用的時區
# CRYPTO_SCHEDULE_TIMEZONE=Asia/Taipei
