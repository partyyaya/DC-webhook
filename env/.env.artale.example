# 複製為 env/.env.artale 後填入；系統環境變數優先。

# ---- Artale 專屬設定 ----
# Artale Discord Webhook 網址（正式發送必填）
ARTALE_DISCORD_WEBHOOK_URL=

# 以下 Artale 設定皆為選填；不共用其他主題的 Webhook 或排程。

# 要檢查的公告分類，逗號分隔；有變化才發送，固定順序：維護 → 更新 → 購物商場
# 只讀第一頁：維護最新 1 篇、版本更新最新 3 篇、商城最新 1 篇；啟動及區間檢查皆適用
# 可用值：update（更新）、bm（購物商場）、event（活動）、maintenance（維護）、sanction（制裁）、all（全部）
# ARTALE_NEWS_CATEGORIES=maintenance,update,bm

# 已發送公告版本的紀錄檔（相對路徑以專案根目錄為準）
# ARTALE_STATE_FILE=data/artale/state.json

# Discord 每則訊息的操作紀錄（所有 Webhook 合計最多 100 筆；供 webhook list 查詢 ID，不含 token）
# ARTALE_DISCORD_MESSAGES_FILE=data/artale/discord-messages.jsonl

# ---- npm run artale:schedule 常駐模式的排程 ----
# 啟動時依上述篇數上限比對第一頁；後續在指定星期與時段內，每隔固定分鐘檢查一次。
# 預設為每週二 08:20～17:20、每 60 分鐘一次（08:20、09:20、…、17:20），以台灣時間計算。

# 星期幾：1～7（1=週一 … 7=週日），可用逗號與範圍，例如 2、1-5、2,4
# ARTALE_SCHEDULE_DAYS=2
# 每天開始與最後一次檢查的時間（24 小時制 HH:MM，不支援跨越午夜）
# ARTALE_SCHEDULE_START=08:20
# ARTALE_SCHEDULE_END=17:20
# 後續排程間隔／回溯分鐘數；啟動不限制回溯時間，所有模式都只讀第一頁
# ARTALE_CHECK_INTERVAL_MINUTES=60
# 計算排程時間用的時區
# ARTALE_SCHEDULE_TIMEZONE=Asia/Taipei
