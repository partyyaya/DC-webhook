# 複製為 env/.env.shared；所有來源共用的 AI 設定。
# 系統環境變數優先；此檔不接受 ARTALE_、CRYPTO_ 專屬設定。
# 若使用 Codex、預設值與已儲存的 CLI 登入資訊，可不建立正式共用環境檔。

# 使用的 AI：codex（預設）或 claude；修改後需重新啟動常駐排程
# AI_PROVIDER=codex
# 單次摘要逾時（毫秒）；Crypto 網路搜尋另用 env/crypto.js 的 aiTimeoutMs
# AI_TIMEOUT_MS=300000

# ---- Codex CLI（AI_PROVIDER=codex）----
# CODEX_BIN=codex
# CODEX_MODEL=
# CODEX_API_KEY=

# ---- Claude Code CLI（AI_PROVIDER=claude）----
# CLAUDE_BIN=claude
# 模型別名（sonnet、opus、haiku）或完整模型 ID；空白使用 Claude Code 預設模型
# CLAUDE_MODEL=
# 不使用 claude auth login 的登入資訊時擇一提供：
#   CLAUDE_CODE_OAUTH_TOKEN：claude setup-token 產生的訂閱 token，使用訂閱額度
#   ANTHROPIC_API_KEY：Anthropic API key，按 API 用量計費；有設定時優先於訂閱登入
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
